					"md": 6,
					"lg": 4,
					"xl": 4
				},
				"simEnabled": {
					"type": "checkbox",
					"label": "Presence simulation active",
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4
