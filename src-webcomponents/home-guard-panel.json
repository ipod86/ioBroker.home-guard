{
	"$schema": "https://raw.githubusercontent.com/ioBroker/web-components/main/schemas/manifest.json",
	"manifestVersion": 1,
	"tag": "iob-home-guard-panel",
	"name": {
		"en": "Home Guard panel",
		"de": "Home Guard Bedienfeld"
	},
	"description": {
		"en": "Alarm system: status, arming, PIN keypad, open windows, presence simulation and logbook",
		"de": "Alarmanlage: Status, Scharfschalten, PIN-Ziffernfeld, offene Fenster, Anwesenheitssimulation und Logbuch"
	},
	"icon": "../home-guard.png",
	"module": "home-guard-panel.js",
	"size": {
		"width": 360,
		"height": 520
	},
	"settings": {
		"type": "panel",
		"items": {
			"instance": {
				"type": "instance",
				"adapter": "home-guard",
				"label": {
					"en": "Instance",
					"de": "Instanz"
				},
				"default": "home-guard.0"
			},
			"night": {
				"type": "checkbox",
				"label": {
					"en": "Button for night protection",
					"de": "Taste für Nachtschutz"
				},
				"default": true
			},
			"open": {
				"type": "checkbox",
				"label": {
					"en": "Show open windows and doors",
					"de": "Offene Fenster und Türen zeigen"
				},
				"default": true
			},
			"sim": {
				"type": "checkbox",
				"label": {
					"en": "Show presence simulation",
					"de": "Anwesenheitssimulation zeigen"
				},
				"default": true
			},
			"persons": {
				"type": "select",
				"label": {
					"en": "Who is at home",
					"de": "Wer ist zu Hause"
				},
				"options": [
					{
						"value": "off",
						"label": {
							"en": "Do not show",
							"de": "Nicht zeigen"
						}
					},
					{
						"value": "home",
						"label": {
							"en": "Only who is at home",
							"de": "Nur wer zu Hause ist"
						}
					},
					{
						"value": "all",
						"label": {
							"en": "At home and away",
							"de": "Zu Hause und weg"
						}
					}
				],
				"default": "off"
			},
			"autoArm": {
				"type": "checkbox",
				"label": {
					"en": "Switch for automatic arming by presence",
					"de": "Schalter „Automatisch scharf/unscharf“"
				},
				"default": true
			},
			"sensors": {
				"type": "checkbox",
				"label": {
					"en": "Monitored sensors (to open)",
					"de": "Überwachte Sensoren (aufklappbar)"
				},
				"default": true
			},
			"log": {
				"type": "number",
				"label": {
					"en": "Logbook entries (0 = none)",
					"de": "Logbuch-Einträge (0 = keine)"
				},
				"min": 0,
				"max": 20,
				"default": 4
			},
			"logOpen": {
				"type": "checkbox",
				"label": {
					"en": "Logbook open at start",
					"de": "Logbuch anfangs ausgeklappt"
				},
				"default": false
			},
			"autoSubmit": {
				"type": "checkbox",
				"label": {
					"en": "Accept the PIN without OK when it is complete",
					"de": "PIN ohne OK bestätigen, sobald er vollständig ist"
				},
				"default": true
			}
		}
	}
}
